# mcp-google-tasks environment. Copy to .env (untracked) and uncomment the section for your
# mode. Every value here is a placeholder. Empty values count as unset; a line left with a
# <placeholder> is read literally, so keep unused lines commented out. Comments go on their
# own lines: `docker run --env-file` does not strip trailing comments from values.
# Reference: docs/configuration.md

# --- Common ---------------------------------------------------------------------------------
# Transport: http (alias streamable-http) or stdio.
# MCP_TRANSPORT=http
# Auth mode: token, resource-server or oauth-proxy.
# MCP_AUTH_MODE=token
# Bind address; the container image sets 0.0.0.0.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_BASE_URL=https://tasks.example.com
# Log level on stderr: debug, info, warning or error.
# MCP_LOG_LEVEL=info
# true/false (also 1/0, yes/no, on/off); any other value is a startup error.
# GOOGLE_TASKS_READONLY=false

# Google OAuth Web client from the Google Cloud console.
# GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>

# --- token mode: single user, stdio or http -------------------------------------------------
# MCP_AUTH_MODE=token
# GOOGLE_OAUTH_REFRESH_TOKEN=<refresh-token>
# Optional; used until Google rejects it.
# GOOGLE_OAUTH_ACCESS_TOKEN=<access-token>
# HTTP only: clients must send it as "Authorization: Bearer <value>".
# MCP_AUTH_TOKEN=<long-random-string>

# --- resource-server mode: multi user behind Obot Remote + Static OAuth, http ---------------
# MCP_AUTH_MODE=resource-server
# MCP_BASE_URL=https://tasks.example.com
# Accepted token audience; GOOGLE_OAUTH_AUDIENCE (comma-separated) overrides it.
# GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_OAUTH_AUDIENCE=<client-id>.apps.googleusercontent.com
# TOKEN_CACHE_TTL_SECONDS=300

# --- oauth-proxy mode: multi user, the server runs Google sign-in, http ---------------------
# MCP_AUTH_MODE=oauth-proxy
# MCP_BASE_URL=https://tasks.example.com
# GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
# GOOGLE_OAUTH_REDIRECT_PATH=/auth/callback
# JWT_SIGNING_KEY=<long-random-string>
# Storage: default, filetree or redis.
# TOKEN_STORAGE_BACKEND=filetree
# STORAGE_ENCRYPTION_KEY=<fernet-key>
# TOKEN_STORAGE_DIR=/data/oauth-tokens
# REDIS_URL=redis://redis.example.com:6379/0
# STORAGE_KEY_PREFIX=<prefix>
# MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://obot.example.com/*

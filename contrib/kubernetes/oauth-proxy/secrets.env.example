# Copy to secrets.env (ignored by git) and replace every value. No quotes, no trailing comments.
# Rotating JWT_SIGNING_KEY or STORAGE_ENCRYPTION_KEY signs every user out.
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
# A long random string, for example: openssl rand -base64 48
JWT_SIGNING_KEY=<long-random-string>
# A Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=<fernet-key>
